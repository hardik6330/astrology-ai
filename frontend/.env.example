# Backend API endpoint.
#
# AUTO-DETECT MODE (recommended for dev):
# Leave as localhost or commented out — the frontend will auto-derive the URL
# from the page's hostname + port 5000. Phone on same Wi-Fi → opening
# http://<pc-ip>:5173 auto-targets http://<pc-ip>:5000/api, no env edits.
#
# OVERRIDE: point to a real backend (ngrok, prod, staging) to skip auto-detect.
# VITE_API_URL=https://your-tunnel.ngrok-free.dev/api
# VITE_API_URL=http://192.168.1.42:5000/api

VITE_API_URL=http://localhost:5000/api
