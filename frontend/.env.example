# Backend API endpoint.
#
# AUTO-DETECT MODE (recommended for dev):
# When VITE_API_URL is unset, empty, or pointed at localhost / 127.0.0.1,
# the frontend derives the URL from the page's hostname + port 5000.
# So opening the app at http://<dev-machine-ip>:5173 from your phone
# automatically calls http://<dev-machine-ip>:5000/api — no env edits needed.
#
# OVERRIDE: set to a real URL to skip auto-detect (production, ngrok, staging).
# VITE_API_URL=https://your-tunnel.ngrok-free.dev/api
VITE_API_URL=http://192.168.1.21:5000/api

# VITE_API_URL=http://localhost:5000/api

VITE_FIREBASE_VAPID_KEY=BChd7XbY7TYXEqLaOBqJSQ5jp-3keX-v2EYgnghNrc_udo4QtxVrdiTxhTJucaXZKTfKbL_a4P7sZ5f4Nr0W_qU

# Auth mode (client-controlled). true = real Firebase Phone OTP.
# false = dummy phone-only login (dev / pre-OTP). Defaults to true if unset.
VITE_OTP_SERVICE=false
