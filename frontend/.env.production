# Production frontend env — COMMITTED on purpose.
#
# Vite bakes VITE_* values into the static JS at BUILD time, and `npm run build`
# (production mode) auto-loads THIS file. None of these are secret — they ship
# inside the public bundle regardless, so there's no reason to keep them in a
# GitHub secret. (Real secrets live in the BACKEND shared/.env on the VPS and
# must never be committed.)
#
# ⚠️ Baked at build time → changing a value here requires a rebuild/redeploy
#    (push to main) to take effect. You can't edit it live on the server.

# Backend API endpoint (public).
VITE_API_URL=https://api-astro-ai.mooo.com/api

# Real Firebase Phone OTP in production (no dev bypass).
VITE_OTP_ENABLED=true

# Web Push (FCM) VAPID PUBLIC key — Firebase Console → Project Settings →
# Cloud Messaging → Web Push certificates. Public by design. Without it, web
# push registration silently no-ops. Paste the real key below.
VITE_FIREBASE_VAPID_KEY=BChd7XbY7TYXEqLaOBqJSQ5jp-3keX-v2EYgnghNrc_udo4QtxVrdiTxhTJucaXZKTfKbL_a4P7sZ5f4Nr0W_qU
