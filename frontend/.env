# Frontend env — the SINGLE env file, used for BOTH dev and production builds.
# COMMITTED on purpose (it's now un-ignored in .gitignore): the production build
# runs in CI from the repo, so the committed values are what ships.
#
# Vite bakes VITE_* into the static JS at BUILD time (npm run build). None of
# these are secret — they ship inside the public bundle regardless. Real secrets
# live in the BACKEND shared/.env on the server and must NEVER be committed.
#
# ⚠️ Baked at build time → changing a value requires a rebuild/redeploy (push to
#    main) to take effect in production. You can't edit it live on the server.
# ⚠️ This file is now used in dev too, so `npm run dev` also hits the prod API
#    below. Point VITE_API_URL at a local backend if you need offline dev.

# Backend API endpoint (public).
VITE_API_URL=https://api-selora.mooo.com/api

# Real Firebase Phone OTP (no dev bypass). Set "false" ONLY to enable the
# bypass for testing — the BACKEND must also have OTP_ENABLED=false for it to work.
VITE_OTP_ENABLED=true

# Web Push (FCM) VAPID PUBLIC key — Firebase Console → Project Settings →
# Cloud Messaging → Web Push certificates. Public by design.
VITE_FIREBASE_VAPID_KEY=BChd7XbY7TYXEqLaOBqJSQ5jp-3keX-v2EYgnghNrc_udo4QtxVrdiTxhTJucaXZKTfKbL_a4P7sZ5f4Nr0W_qU
