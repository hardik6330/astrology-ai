# Dependencies
node_modules/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
**/.env
**/.env.local
**/.env.*.local
# EXCEPTION: frontend/.env is the single, COMMITTED frontend env — it holds only
# public VITE_* values baked into the static bundle (no secrets). Keep this
# negation LAST so it overrides the broad .env ignores above. backend/.env stays
# ignored (real secrets live there).
!frontend/.env
**/*firebase-admin.json

# Build output
dist/
dev-dist/
build/
.vite/

# Logs
*.log
npm-debug.log*

# OS / Editor
.DS_Store
.vscode/
.idea/
*.swp

# temp base64 of firebase service account — local only, delete after use
firebase-b64.txt

# Local-only filled-in prod env (real secrets) — never commit
backend/PROD_ENV_TEMPLATE.txt

# Migration notes — kept local (contains internal/sensitive notes)
backend/MIGRATIONS.md

