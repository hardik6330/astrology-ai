# Dev-only overrides — loaded by `expo run:ios` / `expo start` (development mode),
# and override .env. NOT used by a Release/TestFlight archive.
# iOS simulator reaches the Mac's backend on localhost:5000.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Skip Firebase SMS in dev — log in straight from the typed phone.
# Backend must also run OTP_ENABLED=false to accept it.
EXPO_PUBLIC_OTP_ENABLED=false
