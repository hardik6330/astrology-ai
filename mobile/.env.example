# Optional. Leave blank in dev — app auto-derives backend URL from Expo host.
# Set explicitly for staging/prod builds.
EXPO_PUBLIC_API_URL=http://192.168.1.21:5000/api

# Auth mode (client-controlled). true = real Firebase Phone OTP.
# false = dummy phone-only login (dev / pre-OTP). Defaults to true if unset.
EXPO_PUBLIC_OTP_SERVICE=false

