# Optional. Leave blank in dev — app auto-derives backend URL from Expo host.
# Set explicitly for staging/prod builds.
EXPO_PUBLIC_API_URL=http://192.168.1.21:5000/api


# OTP toggle (client). "false" = dev bypass (no SMS); unset/"true" = real OTP.
# Backend must also run OTP_ENABLED=false for the bypass to be accepted.
EXPO_PUBLIC_OTP_ENABLED=true
