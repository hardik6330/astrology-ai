{
  "expo": {
    "name": "Astrology AI",
    "slug": "astrology-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "astrologyai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/logo-removebg-preview.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc",
      "dark": {
        "backgroundColor": "#050508"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astrologyai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture a photo of your palm for AI reading.",
        "NSPhotoLibraryUsageDescription": "Used to pick a palm photo from your gallery."
      }
    },
    "android": {
      "package": "com.astrologyai.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-removebg-preview.png",
        "backgroundColor": "#0b0a1f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to choose a palm photo.",
          "cameraPermission": "Allow camera access to capture your palm."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",

      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": {},
      "eas": {
        "projectId": "a64b1d82-9d50-4971-938c-f10e61235a7a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a64b1d82-9d50-4971-938c-f10e61235a7a"
    },
    "owner": "hugging00132"
  }
}
