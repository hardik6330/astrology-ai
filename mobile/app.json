{
  "expo": {
    "name": "Astrology AI",
    "slug": "astrology-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "astrologyai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/logo-removebg-preview.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc",
      "dark": {
        "backgroundColor": "#050508"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astrologyai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture a photo of your palm for AI reading.",
        "NSPhotoLibraryUsageDescription": "Used to pick a palm photo from your gallery."
      }
    },
    "android": {
      "package": "com.astrologyai.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-removebg-preview.png",
        "backgroundColor": "#0b0a1f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to choose a palm photo.",
          "cameraPermission": "Allow camera access to capture your palm."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" }
        }
      ]
    ],
    "extra": {
      "apiUrl": {},
      "eas": {
        "projectId": "a51d2fa1-d8fb-4099-a3d8-17de250150a0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a51d2fa1-d8fb-4099-a3d8-17de250150a0"
    }
  }
}
