# Copy this file to .env and fill in your OWN values. NEVER commit a real .env.
# Every value below is FAKE placeholder data — no real secret belongs in this file.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated allowed browser origins in production (no trailing slash).
# Ignored in dev (a permissive localhost/LAN allowlist is used instead).
CORS_ORIGINS=http://localhost:5173,https://astro-ai.example.com

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrology_ai
DB_USER=astro_app
DB_PASS=fake_db_password_change_me
# Optional pool tuning (defaults to max 10 when unset).
# DB_POOL_MAX=10
# DB_POOL_MIN=2

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a fresh high-entropy value: `openssl rand -base64 48`
JWT_SECRET=FaKeJwTsEcReT0000aaaaBBBBccccDDDDeeeeFFFFgggg48ch
JWT_EXPIRES_IN=30d
# Admin tokens MUST use a DIFFERENT secret from JWT_SECRET (enforced in prod).
ADMIN_JWT_SECRET=FaKeAdMiNsEcReT1111zzzzYYYYxxxxWWWWvvvvUUUU48ch

# OTP bypass toggle. Local dev always allows the bare-phone bypass. In production
# the bypass is allowed ONLY if you explicitly set 'false' (⚠️ full auth bypass —
# anyone can mint a session as any phone). Keep unset/'true' on any live deploy.
OTP_ENABLED=true

# ── Google Gemini (REQUIRED — boot fails without it) ──────────────────────────
GEMINI_API_KEY=AIzaSyFAKE-gemini-key-0000000000000000000
# Optional call budgets in ms (defaults: 55000 / 45000). Raise on an always-on host.
# GEMINI_DEADLINE_MS=55000
# GEMINI_ATTEMPT_TIMEOUT_MS=45000

# ── Firebase Admin (push + real verify-otp) ───────────────────────────────────
# Base64-encoded service-account JSON (preferred). Generate: `base64 -w0 firebase-admin.json`
# NEVER commit firebase-admin.json or the decoded JSON.
FIREBASE_SERVICE_ACCOUNT_B64=ZmFrZS1maXJlYmFzZS1zZXJ2aWNlLWFjY291bnQtanNvbi1iYXNlNjQ=
# Alternative: raw service-account JSON in one line (the code reads _JSON, not _PATH).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"fake-project",...}
# Dev fallback: drop the file at backend/src/config/firebase-admin.json (no env var).

# ── Back-office admin (seeded once on first boot if no admin exists) ───────────
# Production rejects the default 'changeme123' — set a strong one.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FakeStrongAdminPass!23

# ── Razorpay (WEB payments) — leave unset to use mock checkout in dev ──────────
# In production, mock checkout fails closed (503) — Razorpay MUST be set if payments are live.
# RAZORPAY_KEY_ID=rzp_test_FAKE0000000000
# RAZORPAY_KEY_SECRET=fake_razorpay_key_secret_0000

# ── Mobile native IAP — leave unset to use mock path in dev (fails closed prod) ─
# APPLE_IAP_SECRET=fake_apple_shared_secret_0000
# GOOGLE_IAP_SERVICE_ACCOUNT_JSON=./src/config/google-iap-service-account.json

# ── Optional / rarely needed ──────────────────────────────────────────────────
# Google Maps key — location lookup uses free OpenStreetMap Nominatim by default;
# only needed if you re-enable the (currently commented-out) Google fallback.
# GOOGLE_MAPS_API_KEY=AIzaSyFAKE-maps-key-0000000000000000000
