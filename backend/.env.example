# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrology_ai
DB_USER=root
DB_PASSWORD=
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=30d
# Optional — Google Maps key. Location lookup uses free OpenStreetMap
# Nominatim by default; this is only needed if you re-enable the commented
# Google fallback path in services/locationService.js.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Admin service account (base64-encoded JSON). Required for push
# notifications (FCM) and the real verify-otp auth path. Generate with:
#   base64 -w0 firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_B64=

# Auth mode is now decided client-side, not here: the web client uses
# VITE_OTP_SERVICE and the mobile client uses EXPO_PUBLIC_OTP_SERVICE.
# The backend exposes both /auth/verify-otp and /auth/dummy-login unconditionally.

# Shared secret the external scheduler sends in the x-cron-secret header to
# trigger /api/cron/* push campaigns. Min 16 chars. Cron routes 503 until set.
# CRON_SECRET=replace-with-a-long-random-string

# Default back-office admin, seeded once on first boot if no admin exists.
# All optional — these defaults are used when unset. Change the password!
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Razorpay (WEB payments). Get test keys from the Razorpay Dashboard →
# Settings → API Keys. Leave unset to keep the mock checkout (dev). KEY_ID is
# returned to the browser to open Checkout; KEY_SECRET stays server-only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_test_key_secret






