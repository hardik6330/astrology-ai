# Copy this file to .env and fill in your OWN values. NEVER commit a real .env.
# Every value below is a placeholder — no real secret belongs in this file.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrology_ai
DB_USER=root
DB_PASS=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a fresh high-entropy value: `openssl rand -base64 48`
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_EXPIRES_IN=30d
# Admin tokens MUST use a DIFFERENT secret from JWT_SECRET (enforced in prod).
ADMIN_JWT_SECRET=replace-with-a-DIFFERENT-openssl-rand-base64-48

# OTP bypass toggle. Local dev always allows the bypass. In production the
# bypass is COMPILED OUT — /auth/verify-otp refuses a bare phone regardless of
# this flag. Keep unset/'true'. (Never 'false' on a live deploy.)
OTP_ENABLED=true

# ── Google Gemini (required for AI readings) ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Google Maps key — location lookup uses free OpenStreetMap Nominatim
# by default; only needed if you re-enable the Google fallback in locationService.
# GOOGLE_MAPS_API_KEY=

# ── Firebase Admin (push + real verify-otp) ───────────────────────────────────
# Base64-encoded service-account JSON. Generate: `base64 -w0 firebase-admin.json`
# NEVER commit firebase-admin.json or the decoded JSON.
# FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-admin.json   # dev only

# ── Cron / engagement pushes ──────────────────────────────────────────────────
# Shared secret the external scheduler sends in x-cron-secret. Min 16 chars.
# CRON_SECRET=replace-with-openssl-rand-hex-32

# ── Back-office admin (seeded once on first boot if no admin exists) ───────────
# Production rejects the default password — set a strong one.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-launch

# ── Razorpay (WEB payments) — leave unset to use mock checkout in dev ──────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_test_key_secret

# ── Mobile native IAP — leave unset to use mock path in dev (fails closed prod) ─
# APPLE_IAP_SECRET=
# GOOGLE_IAP_SERVICE_ACCOUNT_JSON=

# NOTE: Do NOT set VERCEL here. It is injected by the Vercel platform only; a
# local VERCEL=1 makes the dev server skip app.listen() and exit immediately.
