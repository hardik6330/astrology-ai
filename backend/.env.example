# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrology_ai
DB_USER=root
DB_PASSWORD=
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=30d
# Optional — Google Maps key. Location lookup uses free OpenStreetMap
# Nominatim by default; this is only needed if you re-enable the commented
# Google fallback path in services/locationService.js.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
